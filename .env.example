# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in the values before launching.
# Do not commit secrets/live keys to git control.
# ==============================================================================

# Server Configuration
NODE_ENV=production
PORT=10000

# Database Configuration (MongoDB)
# Local Dev: mongodb://localhost:27017/islm
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>
MONGO_URI=mongodb+srv://admin:secure_password@cluster0.mongodb.net/islm

# Authentication Secret (Minimum 32 character high-entropy key)
JWT_SECRET=your_32_character_long_cryptographically_secure_jwt_secret_here

# Client Access Control (CORS Config)
CLIENT_URL=https://islm-production-app.onrender.com